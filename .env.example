# Copy to .env and fill in. Never commit .env.

# Home Assistant: dedicated Winston user, long-lived access token (plan §6 rule 5)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Cloud handoff for hard tasks (ask_claude tool). Only the question text leaves the LAN.
ANTHROPIC_API_KEY=

# Text channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
